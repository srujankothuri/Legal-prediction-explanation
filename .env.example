# Copy to .env and fill in your values
# ============================================================================

# Together AI API key (for legal chatbot — Mistral-7B)
TOGETHER_API_KEY=your_together_ai_api_key_here

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Device override (auto, cuda, mps, cpu) — leave as auto for detection
DEVICE=auto
